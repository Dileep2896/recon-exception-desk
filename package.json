{
  "name": "recon-exception-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-backed bank reconciliation review for AI accounting agents",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-public.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
